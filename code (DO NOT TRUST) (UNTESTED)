//hii

#include <Wire.h>
#include <XboxSeriesXControllerESP32_asukiaaa.hpp>

#define LEFT_A 16
#define LEFT_B 17
#define RIGHT_A 18
#define RIGHT_B 19
#define SLEEP_PIN 23

#define MPU_ADDR 0x68

#define STICK_CENTER 32768
#define DEADZONE 8000
#define TILT_LIMIT 40.0  // degrees before it cuts the motors, just guessed this, tune by hand

XboxSeriesXControllerESP32_asukiaaa::Core xboxController;

void setup() {
  Serial.begin(115200);

  pinMode(LEFT_A, OUTPUT);
  pinMode(LEFT_B, OUTPUT);
  pinMode(RIGHT_A, OUTPUT);
  pinMode(RIGHT_B, OUTPUT);
  pinMode(SLEEP_PIN, OUTPUT);
  digitalWrite(SLEEP_PIN, HIGH); // wake the driver up and just leave it on

  Wire.begin();
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B); // power mgmt reg
  Wire.write(0);    // wake it up
  Wire.endTransmission(true);

  xboxController.begin();
}

void stopMotors() {
  digitalWrite(LEFT_A, LOW);
  digitalWrite(LEFT_B, LOW);
  digitalWrite(RIGHT_A, LOW);
  digitalWrite(RIGHT_B, LOW);
}

float getTiltDeg() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 6, true);

  int16_t ax = Wire.read() << 8 | Wire.read();
  int16_t ay = Wire.read() << 8 | Wire.read();
  int16_t az = Wire.read() << 8 | Wire.read();

  float axg = ax / 16384.0;
  float ayg = ay / 16384.0;
  float azg = az / 16384.0;

  // angle away from straight up, don't care which direction it fell
  return atan2(sqrt(axg * axg + ayg * ayg), azg) * 180.0 / PI;
}

void loop() {
  xboxController.onLoop();

  float tilt = getTiltDeg();
  if (tilt > TILT_LIMIT) {
    stopMotors();
    Serial.println("tipped over, motors off");
    delay(50);
    return;
  }

  if (!xboxController.isConnected()) {
    stopMotors();
    delay(50);
    return;
  }

  int lVert = xboxController.xboxNotif.joyLVert;
  int rVert = xboxController.xboxNotif.joyRVert;

  // left motor - flip the HIGH/LOW if wong way
  if (lVert > STICK_CENTER + DEADZONE) {
    digitalWrite(LEFT_A, HIGH);
    digitalWrite(LEFT_B, LOW);
  } else if (lVert < STICK_CENTER - DEADZONE) {
    digitalWrite(LEFT_A, LOW);
    digitalWrite(LEFT_B, HIGH);
  } else {
    digitalWrite(LEFT_A, LOW);
    digitalWrite(LEFT_B, LOW);
  }

  // right motor, same deal
  if (rVert > STICK_CENTER + DEADZONE) {
    digitalWrite(RIGHT_A, HIGH);
    digitalWrite(RIGHT_B, LOW);
  } else if (rVert < STICK_CENTER - DEADZONE) {
    digitalWrite(RIGHT_A, LOW);
    digitalWrite(RIGHT_B, HIGH);
  } else {
    digitalWrite(RIGHT_A, LOW);
    digitalWrite(RIGHT_B, LOW);
  }

  delay(20);
}
